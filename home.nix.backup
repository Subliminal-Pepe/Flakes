{ caelestia-shell, ... }:

{
  home.username = "mac";
  home.homeDirectory = "/home/Mac-NixOS";
  home.stateVersion = "26.05";

  programs.caelestia = {
    enable = true;
    cli.enable = true;

    systemd = {
      enable = true;
      target = "graphical-session.target";
      environment = [];
    };
  };
}
